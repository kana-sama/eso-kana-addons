<GuiXml>
    <Controls>
        <Control name="KanaZoneGoalsRow" inherits="ZO_WorldMapZoneStoryRow_Keyboard" virtual="true">
            <OnMouseEnter>KanaZoneGoals.ShowGoalTooltip(self)</OnMouseEnter>
            <OnMouseExit>KanaZoneGoals.LeaveTooltip()</OnMouseExit>
            <OnMouseUp>if upInside then KanaZoneGoals.RowClicked(self, button) end</OnMouseUp>
        </Control>
        <Control name="KanaZoneGoalsTooltipRow" inherits="ZO_CompletionTypeCheckbox" mouseEnabled="true" virtual="true">
            <OnMouseUp>if upInside then KanaZoneGoals.GoalClicked(self, button) end</OnMouseUp>
        </Control>
        <Control name="KanaZoneGoalsTooltipSpacer" virtual="true"/>
        <Control name="KanaZoneGoalsTooltipPair" virtual="true">
            <Controls>
                <Control name="$(parent)Left" inherits="KanaZoneGoalsTooltipRow">
                    <Anchor point="TOPLEFT"/>
                </Control>
                <Control name="$(parent)Right" inherits="KanaZoneGoalsTooltipRow">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Left" relativePoint="TOPRIGHT" offsetX="30"/>
                </Control>
            </Controls>
        </Control>
        <Control name="KanaZoneGoalsAntiquityBlock" mouseEnabled="true" virtual="true">
            <OnMouseUp>if upInside then KanaZoneGoals.GoalClicked(self, button) end</OnMouseUp>
            <Controls>
                <Texture name="$(parent)Checkbox" textureFile="EsoUI/Art/Cadwell/check.dds" resizeToFitFile="true">
                    <Anchor point="TOPLEFT" offsetY="2"/>
                </Texture>
                <Label name="$(parent)Name" font="ZoFontGameBold"/>
                <Label name="$(parent)Reward" font="ZoFontGameSmall"/>
                <Label name="$(parent)Source" font="ZoFontGameSmall"/>
            </Controls>
        </Control>
        <TopLevelControl name="KanaZoneGoalsTooltip" hidden="true" mouseEnabled="true" clampedToScreen="true" tier="HIGH" level="ZO_HIGH_TIER_TOOLTIPS">
            <Dimensions x="480" y="300"/>
            <OnMouseExit>KanaZoneGoals.LeaveTooltip()</OnMouseExit>
            <OnMouseUp>if upInside then KanaZoneGoals.MapRightClick(button) end</OnMouseUp>
            <Controls>
                <Backdrop name="$(parent)BG" inherits="ZO_DefaultBackdrop"><AnchorFill/></Backdrop>
                <Label name="$(parent)Title" font="ZoFontGameBold" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED">
                    <Anchor point="TOPLEFT" offsetX="10" offsetY="10"/>
                    <Anchor point="TOPRIGHT" offsetX="-10" offsetY="10"/>
                </Label>
                <Label name="$(parent)Measure" inherits="ZO_AchievementsDefaultLabel_Keyboard" hidden="true">
                    <Anchor point="TOPLEFT"/>
                </Label>
                <Control name="$(parent)List" inherits="ZO_ScrollList">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Title" relativePoint="BOTTOMLEFT" offsetY="10"/>
                    <Anchor point="BOTTOMRIGHT" offsetX="-10" offsetY="-10"/>
                </Control>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
